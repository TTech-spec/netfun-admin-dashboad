# The SAME Supabase project the NetFun app uses (Project Settings → API).
# Only the public anon key goes here — never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the NetFun app's address, used for "View in app" links.
VITE_APP_URL=https://your-netfun-domain.com
